# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Database
DB_PATH=./data/schedule.db

# Session
SESSION_SECRET=change-me-in-production

# Доверенные reverse proxy через запятую. Оставьте пустым при прямом доступе.
TRUST_PROXY=

# Журнал ошибок: предел 5 МиБ, после него сохраняются три предыдущие копии.
ERROR_LOG_MAX_BYTES=5242880

# Default admin (создаётся при первом запуске, СМЕНИТЬ пароль!)
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=admin

# Пароль-подтверждение полной очистки БД (хэш сохраняется в data/config.json, СМЕНИТЬ!)
DEFAULT_RESET_PASSWORD=2707
